# AIS Dashboard Build & Deployment Configuration
#
# Copy this file to `config.yaml` (in this same directory) and edit it to
# customize your installation. `helpers/build.py` reads `config.yaml` and
# falls back to the defaults below for any missing key, so this file is
# always a safe, complete reference of every available option.
#
# NOTE: gateway host/port, own-vessel MMSI and the stale timeout are
# configured on the `ais_targets` integration itself (Settings → Devices &
# Services → AIS Targets → Configure) — that config entry is the single
# source of truth for the running component. This file only controls how the
# dashboard is *built* (map size, which table columns to show).

# ── Map card (src/yaml/dashboard/sections/01_ais_map.yaml) ──────────────────
map:
  # Initial zoom level of the `type: map` card (higher = more zoomed in).
  default_zoom: 12
  # Fixed height of the map card in pixels. The card spans the FULL dashboard
  # content width (not fullscreen); this pins its height so it never grows
  # into a full-screen panel.
  height_px: 480

# ── Detail/list table (custom:auto-entities + custom:flex-table-card) ───────
# Which identity/voyage columns to show for each tracked vessel, and in what
# order. Every id below maps 1:1 to an attribute the ais_targets integration
# exposes (see custom_components/ais_targets/geo_location.py); unknown ids are
# ignored by helpers/build.py. A leading "Vessel" (friendly name) column and
# the live nav columns (sog, cog, heading, nav_status, last_seen) are always
# appended automatically, so you never lose them by trimming this list.
detail_fields:
  - mmsi
  - vessel_name
  - callsign
  - ship_type
  - length
  - beam
  - destination
