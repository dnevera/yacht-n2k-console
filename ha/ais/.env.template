# ha/ais environment — SELF-CONTAINED
#
# Copy this file to `.env` (gitignored) and edit it. This mirrors
# ha/sailing-dash/.env.template exactly (same profile mechanism, same
# variable names) so both dashboard packages target the same boxes with the
# same conventions. The repo root `.env` / `deploy.conf` belong to the
# ydnu-02 manager and are NEVER read from here.
#
# Targets are NAMED PROFILES, not a fixed stage/prod pair: list them in
# HA_PROFILES and describe each one with variables prefixed by the profile
# name uppercased, with "-" replaced by "_" (profile `stage-pi5` -> `STAGE_PI5_*`).
#
# Per profile:
#   <P>_TRANSPORT      local-docker (docker on this machine) | ssh-docker
#   <P>_SSH_HOST       ssh destination (user@host); ignored by local-docker
#   <P>_CONTAINER      Home Assistant container name on that machine
#   <P>_CONFIG_DIR     HA config directory inside the container
#   <P>_HA_URL         HA base URL (readiness checks; unused by this package today)
#   <P>_HA_TOKEN       long-lived access token (unused by this package today)
#   <P>_GW_HOST        YDNU-02 tcp-gw host as seen BY HOME ASSISTANT
#   <P>_GW_DATA_PORT   tcp-gw RAW/text data port (the nmea2000 config entry)
#
# Every value below is written as ${VAR:-default} on purpose: a real
# environment variable still wins, so one-off overrides keep working:
#   PROD_CONTAINER=ha-test ./deploy.sh --target prod

HA_PROFILES="${HA_PROFILES:-stage prod}"

# ── stage: an environment to verify changes on (any container, any machine) ───
STAGE_TRANSPORT="${STAGE_TRANSPORT:-local-docker}"
STAGE_SSH_HOST="${STAGE_SSH_HOST:-}"
STAGE_CONTAINER="${STAGE_CONTAINER:-local-ha}"
STAGE_CONFIG_DIR="${STAGE_CONFIG_DIR:-/config}"
STAGE_HA_URL="${STAGE_HA_URL:-http://localhost:8123}"
STAGE_HA_TOKEN="${STAGE_HA_TOKEN:-}"
STAGE_GW_HOST="${STAGE_GW_HOST:-127.0.0.1}"
STAGE_GW_DATA_PORT="${STAGE_GW_DATA_PORT:-4001}"

# ── prod: the real vessel server ─────────────────────────────────────────────
# Deliberately NOT copied from ha/sailing-dash/.env — that file holds real
# prod credentials and is never read or overwritten by this package.
PROD_TRANSPORT="${PROD_TRANSPORT:-ssh-docker}"
PROD_SSH_HOST="${PROD_SSH_HOST:-user@vessel-pi5}"
PROD_CONTAINER="${PROD_CONTAINER:-homeassistant}"
PROD_CONFIG_DIR="${PROD_CONFIG_DIR:-/config}"
PROD_HA_URL="${PROD_HA_URL:-http://vessel-pi5:8123}"
PROD_HA_TOKEN="${PROD_HA_TOKEN:-}"
PROD_GW_HOST="${PROD_GW_HOST:-127.0.0.1}"
PROD_GW_DATA_PORT="${PROD_GW_DATA_PORT:-4001}"
