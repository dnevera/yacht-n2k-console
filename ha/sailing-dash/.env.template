# ha/sailing-dash environment — SELF-CONTAINED
#
# Copy this file to `.env` (gitignored) and edit it. This is the ONLY source of
# truth about environments for this subproject. The repo root `.env` /
# `deploy.conf` belong to the ydnu-02 manager and are NEVER read from here — so a
# production host configured there can never leak into a stage deploy.
#
# Targets are NAMED PROFILES, not a fixed stage/prod pair: list them in
# HA_PROFILES and describe each one with variables prefixed by the profile name
# uppercased, with "-" replaced by "_" (profile `stage-pi5` -> `STAGE_PI5_*`).
# That is how several Pi5 boxes can be described side by side.
#
# Per profile:
#   <P>_TRANSPORT      local-docker (docker on this machine) | ssh-docker
#   <P>_SSH_HOST       ssh destination (user@host); ignored by local-docker
#   <P>_CONTAINER      Home Assistant container name on that machine
#   <P>_CONFIG_DIR     HA config directory inside the container
#   <P>_HA_URL         HA base URL (readiness checks, REST auto-discovery)
#   <P>_HA_TOKEN       long-lived access token (optional; REST auto-discovery)
#   <P>_GW_HOST        YDNU-02 tcp-gw host as seen BY HOME ASSISTANT
#   <P>_GW_DATA_PORT   tcp-gw RAW/text data port (the nmea2000 config entry)
#
# Every value below is written as ${VAR:-default} on purpose: a real environment
# variable still wins, so one-off overrides keep working:
#   PROD_CONTAINER=ha-test ./deploy.sh --target prod

HA_PROFILES="${HA_PROFILES:-stage prod}"

# ── stage: an environment to verify changes on (any container, any machine) ───
# Provisioning shortcuts (onboarding bypass, test/test, mock emulator) are
# allowed here only.
STAGE_TRANSPORT="${STAGE_TRANSPORT:-local-docker}"
STAGE_SSH_HOST="${STAGE_SSH_HOST:-}"
STAGE_CONTAINER="${STAGE_CONTAINER:-local-ha}"
STAGE_CONFIG_DIR="${STAGE_CONFIG_DIR:-/config}"
STAGE_HA_URL="${STAGE_HA_URL:-http://localhost:8123}"
STAGE_HA_TOKEN="${STAGE_HA_TOKEN:-}"
# 127.0.0.1 works because the bundled local-ha compose stack uses
# network_mode: host, so the mock emulator on the laptop is reachable as-is.
STAGE_GW_HOST="${STAGE_GW_HOST:-127.0.0.1}"
STAGE_GW_DATA_PORT="${STAGE_GW_DATA_PORT:-4001}"

# ── prod: the real vessel server ─────────────────────────────────────────────
PROD_TRANSPORT="${PROD_TRANSPORT:-ssh-docker}"
PROD_SSH_HOST="${PROD_SSH_HOST:-user@vessel-pi5}"
PROD_CONTAINER="${PROD_CONTAINER:-homeassistant}"
PROD_CONFIG_DIR="${PROD_CONFIG_DIR:-/config}"
PROD_HA_URL="${PROD_HA_URL:-http://vessel-pi5:8123}"
PROD_HA_TOKEN="${PROD_HA_TOKEN:-}"
PROD_GW_HOST="${PROD_GW_HOST:-127.0.0.1}"
PROD_GW_DATA_PORT="${PROD_GW_DATA_PORT:-4001}"

# ── a second Pi5, used as a remote stage box ─────────────────────────────────
# Add "stage-pi5" to HA_PROFILES to enable it, then: ./deploy.sh --target stage-pi5
STAGE_PI5_TRANSPORT="${STAGE_PI5_TRANSPORT:-ssh-docker}"
STAGE_PI5_SSH_HOST="${STAGE_PI5_SSH_HOST:-pi@stage-pi5.local}"
STAGE_PI5_CONTAINER="${STAGE_PI5_CONTAINER:-homeassistant}"
STAGE_PI5_CONFIG_DIR="${STAGE_PI5_CONFIG_DIR:-/config}"
STAGE_PI5_HA_URL="${STAGE_PI5_HA_URL:-http://stage-pi5.local:8123}"
STAGE_PI5_HA_TOKEN="${STAGE_PI5_HA_TOKEN:-}"
STAGE_PI5_GW_HOST="${STAGE_PI5_GW_HOST:-127.0.0.1}"
STAGE_PI5_GW_DATA_PORT="${STAGE_PI5_GW_DATA_PORT:-4001}"
