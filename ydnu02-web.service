[Unit]
Description=YDNU-02 NMEA 2000 Web Console
# ydnu02-tcp-gateway must be running first — it holds /dev/ttyACM0 and exposes :4001/:4002
After=network.target bluetooth.target ydnu02-tcp-gateway.service
Wants=network.target bluetooth.target
Requires=ydnu02-tcp-gateway.service

[Service]
Type=simple
User=denn
WorkingDirectory=/opt/nmea2000/ydnu02-web
ExecStart=/usr/bin/python3 /opt/nmea2000/ydnu02-web/app.py --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ydnu02-web

# Serial port + BLE access
SupplementaryGroups=dialout bluetooth

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/nmea2000/ydnu02-web
ProtectHome=false

[Install]
WantedBy=multi-user.target
